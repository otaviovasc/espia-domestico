# Replace placeholders in Railway Variables; never commit real secrets.
NODE_ENV=production
PORT=3100
API_PREFIX=/api/v1
LOG_LEVEL=info
DATABASE_URL=${{Postgres.DATABASE_URL}}
JWT_SECRET=REPLACE_WITH_EXISTING_SHARED_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d
COOKIE_SECURE=true
CORS_ORIGIN=https://REPLACE_FRONTEND_DOMAIN
FRONTEND_URL=https://REPLACE_FRONTEND_DOMAIN
API_BASE_URL=https://REPLACE_API_DOMAIN
UAZAPI_BASE_URL=https://free.uazapi.com
UAZAPI_ADMIN_TOKEN=REPLACE_WITH_EXISTING_TOKEN
RUN_SCHEDULER=true
# OpenRouter: paid calls are opt-in, never triggered by page loads.
# Set these identically on API and worker; one shared database enforces budgets.
AI_ENABLED=false
OPENROUTER_KEY=REPLACE_WITH_OPENROUTER_KEY
CLASSIFICATION_MODEL=deepseek/deepseek-v4.1-flash
SMART_CLASSIFICATION_MODEL=deepseek/deepseek-v4.1-flash
SMART_KEYWORD_MODEL=deepseek/deepseek-v4.1-flash
SMART_COPY_MODEL=deepseek/deepseek-v4.1-flash
# USD per MILLION tokens; provider price ceilings and conservative budget accounting.
AI_INPUT_COST_USD_PER_MILLION=0.20
AI_OUTPUT_COST_USD_PER_MILLION=0.80
AI_DAILY_REQUEST_LIMIT=1000
AI_DAILY_INPUT_TOKEN_LIMIT=2000000
AI_DAILY_OUTPUT_TOKEN_LIMIT=250000
AI_DAILY_COST_LIMIT_USD=2
AI_GLOBAL_DAILY_COST_LIMIT_USD=5
AI_REQUEST_COST_LIMIT_USD=0.02
AI_CACHE_TTL_HOURS=168
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_INPUT_TOKENS=12000
AI_MAX_OUTPUT_TOKENS=4000

