# ── App ─────────────────────────────────────────────
NODE_ENV=development
PORT=3100
API_PREFIX=/api/v1
LOG_LEVEL=debug

# ── CORS / Frontend ─────────────────────────────────
CORS_ORIGIN=http://localhost:5273
FRONTEND_URL=http://localhost:5273

# ── Database (matches docker-compose.yml) ───────────
DATABASE_URL=postgresql://achadinhos:achadinhos_dev@localhost:5433/achadinhos

# ── Auth ────────────────────────────────────────────
# Must be at least 32 chars. Generate: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d
# Cookie is sent over HTTPS only when true (set true in production)
COOKIE_SECURE=false

# Optional: create the first admin user on boot if no users exist
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ── UAZAPI (backend only — never expose admin token) ─
UAZAPI_ADMIN_TOKEN=
UAZAPI_BASE_URL=https://free.uazapi.com

# Public base URL where UAZAPI can reach this backend for webhooks.
# In local dev use an ngrok/tunnel URL; leave empty to skip webhook registration.
API_BASE_URL=

# ── Campaign scheduler / worker ─────────────────────
# Local dev runs API + scheduler in one process (true). On Railway split:
#   API service     → RUN_SCHEDULER=false (never sends; survives deploys)
#   Worker service  → RUN_SCHEDULER=true  (owns all campaign sending)
RUN_SCHEDULER=true

# OpenRouter: paid calls are opt-in, never triggered by page loads.
# Set these identically on API and worker; one shared database enforces budgets.
AI_ENABLED=false
OPENROUTER_KEY=
CLASSIFICATION_MODEL=deepseek/deepseek-v4.1-flash
SMART_CLASSIFICATION_MODEL=deepseek/deepseek-v4.1-flash
SMART_KEYWORD_MODEL=deepseek/deepseek-v4.1-flash
SMART_COPY_MODEL=deepseek/deepseek-v4.1-flash
# USD per MILLION tokens; provider price ceilings and conservative budget accounting.
AI_INPUT_COST_USD_PER_MILLION=0.20
AI_OUTPUT_COST_USD_PER_MILLION=0.80
AI_DAILY_REQUEST_LIMIT=1000
AI_DAILY_INPUT_TOKEN_LIMIT=2000000
AI_DAILY_OUTPUT_TOKEN_LIMIT=250000
AI_DAILY_COST_LIMIT_USD=2
AI_GLOBAL_DAILY_COST_LIMIT_USD=5
AI_REQUEST_COST_LIMIT_USD=0.02
AI_CACHE_TTL_HOURS=168
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_INPUT_TOKENS=12000
AI_MAX_OUTPUT_TOKENS=4000

# ── Biblioteca de anúncios ──────────────────────────
# FFmpeg and FFprobe must be installed on the backend host.
# Local development storage and temporary upload/render workspace.
AD_MEDIA_DIR=./data/ad-media
# In Railway production, use a private Storage Bucket and set the AD_S3_*
# variables below as Railway references to the bucket's variables.
AD_STORAGE_DRIVER=local
# AD_S3_BUCKET=${{ad-library-media.BUCKET}}
# AD_S3_ENDPOINT=${{ad-library-media.ENDPOINT}}
# AD_S3_REGION=${{ad-library-media.REGION}}
# AD_S3_ACCESS_KEY_ID=${{ad-library-media.ACCESS_KEY_ID}}
# AD_S3_SECRET_ACCESS_KEY=${{ad-library-media.SECRET_ACCESS_KEY}}
AD_MAX_CLIP_MB=100
AD_MAX_MUSIC_MB=50
AD_RENDER_CONCURRENCY=2
# Optional path to a font file for burned-in captions.
AD_FONT_FILE=
