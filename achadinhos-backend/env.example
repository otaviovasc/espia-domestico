# ── App ─────────────────────────────────────────────
NODE_ENV=development
PORT=3100
API_PREFIX=/api/v1
LOG_LEVEL=debug

# ── CORS / Frontend ─────────────────────────────────
CORS_ORIGIN=http://localhost:5273
FRONTEND_URL=http://localhost:5273

# ── Database (matches docker-compose.yml) ───────────
DATABASE_URL=postgresql://achadinhos:achadinhos_dev@localhost:5433/achadinhos

# ── Auth ────────────────────────────────────────────
# Must be at least 32 chars. Generate: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d
# Cookie is sent over HTTPS only when true (set true in production)
COOKIE_SECURE=false

# Optional: create the first admin user on boot if no users exist
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ── UAZAPI (backend only — never expose admin token) ─
UAZAPI_ADMIN_TOKEN=
UAZAPI_BASE_URL=https://free.uazapi.com

# Public base URL where UAZAPI can reach this backend for webhooks.
# In local dev use an ngrok/tunnel URL; leave empty to skip webhook registration.
API_BASE_URL=

# Jev categorization through OpenRouter Decisions API (required for product imports)
OPENROUTER_KEY=
