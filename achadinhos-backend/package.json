{
  "name": "achadinhos-backend",
  "version": "0.1.0",
  "description": "Scoped WhatsApp product-offer broadcaster backend (UAZAPI)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev -r tsconfig-paths/register --respawn src/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias",
    "start": "node -r tsconfig-paths/register dist/server.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "db:create": "sequelize-cli db:create",
    "db:reset": "sequelize-cli db:drop && sequelize-cli db:create && npm run migrate",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "validate": "npm run type-check && npm run lint",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:catalog:integration": "npm run build && node --test test/saved-products.integration.cjs"
  },
  "keywords": [
    "whatsapp",
    "uazapi",
    "broadcast",
    "offers"
  ],
  "license": "ISC",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.122",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.0.1",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.7",
    "tsconfig-paths": "^4.2.0",
    "tsyringe": "^4.10.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.8",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.6.2",
    "sequelize-cli": "^6.6.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.49.0"
  }
}
