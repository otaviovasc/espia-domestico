{
  "name": "achadinhos-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:landings && tsc --noEmit && vite build",
    "test:imports": "node --experimental-strip-types --test test/import-workflow.test.mjs",
    "test:studio": "node --experimental-strip-types --test test/ad-studio.test.mjs",
    "test:creative": "node --experimental-strip-types --test test/ad-composition.test.mjs test/ad-creative-workbench.test.mjs test/ad-export-readiness.test.mjs test/ad-media-library.test.mjs",
    "test:preview": "node --experimental-strip-types --test test/ad-preview-parity.test.mjs",
    "preview": "vite preview",
    "start": "serve dist -l ${PORT:-5273}",
    "lint": "eslint .",
    "test:ui": "node --experimental-strip-types --test test/theme.test.mjs test/api-error-message.test.mjs test/catalog-import-state.test.mjs",
    "test:smart": "node --experimental-strip-types --test test/smart-search-preset.test.mjs test/smart-ai-safety.test.mjs test/smart-campaign-ui.test.mjs",
    "build:landings": "node --experimental-strip-types landing/build.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-query": "^5.90.12",
    "axios": "^1.13.2",
    "lucide-react": "^0.556.0",
    "motion": "^12.34.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "serve": "^14.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vite": "^7.2.4"
  }
}
