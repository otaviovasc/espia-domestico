# Frontend build-time config.
#
# In production the frontend and backend are separate hosts, so the app must
# know the backend's public URL. This is a BUILD-TIME variable (Vite inlines it),
# so it must be set before `npm run build` — on Railway set it as a service
# variable and redeploy so the build picks it up.
#
# Point it at your backend's public API base, including /api/v1:
VITE_API_BASE=https://your-backend.up.railway.app/api/v1

# In local dev leave this UNSET — the Vite dev server proxies /api to :3100.
