{
  "trailingSlash": false,
  "directoryListing": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/painel", "destination": "/painel/index.html" },
    { "source": "/painel/connection", "destination": "/painel/index.html" },
    { "source": "/painel/compose", "destination": "/painel/index.html" },
    { "source": "/painel/campaigns", "destination": "/painel/index.html" },
    { "source": "/painel/campaigns/:id", "destination": "/painel/index.html" },
    { "source": "/painel/:path([^.]+)", "destination": "/painel/index.html" }
  ],
  "headers": [
    {
      "source": "/painel/assets/**",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "*.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
